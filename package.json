  "scripts": {
    "build": "npm run bundle:css && npm run bundle-js",
    "start": "npm run build && node server/server.js",
    "dev": "npm run build && nodemon server/server.js",
    "test": "node --test",
    "bundle:css": "postcss public/stylesheets/main.css -o public/build/bundle.css --no-map",
    "watch:css": "postcss --watch public/stylesheets/main.css -o public/build/bundle.css --no-map",
    "bundle-js": "browserify public/javascript/main.js -o public/build/newt-bundle.js --debug"
  },
